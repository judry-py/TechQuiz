# ==============================================================================
# TechQuiz - Configuration des variables d'environnement
# Copiez ce fichier vers .env.local et renseignez vos clés réelles.
# ==============================================================================

# Supabase (Obligatoire - Tier gratuit sur supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Fournisseur IA Principal - Google AI Studio (Gratuit)
# Obtenez une clé sur https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.5-flash-lite

# Fournisseur IA Secours - OpenRouter (Modèles gratuits :free)
# Obtenez une clé sur https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Limite quotidienne de corrections par utilisateur (Par défaut : 20)
DAILY_GRADING_LIMIT=20
